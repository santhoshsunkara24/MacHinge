# ==============================================================================
# MacHinge — .gitignore
# ==============================================================================

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Swift Package Manager & Xcode
/.build/
/Packages/
DerivedData/
xcuserdata/
*.xcodeproj/
*.xcworkspace/
.swiftpm/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata

# Local Debug Scripts & Scratch Files
debug_pipeline.swift
test_live_app.swift
scratch/
*.log

# Media & Screen Recordings
*.mp4
*.mov
*.m4v

# Binary Distribution Artifacts (Build output)
Release/MacHinge.app/
*.dmg
*.zip
!Release/*.dmg
!Release/*.zip
!website/downloads/*.dmg

# Secrets & Credentials
.env
*.env
.netrc
*.p12
*.cer
*.key
*.pem
*.provisionprofile
*.mobileprovision
.vercel
.env*
